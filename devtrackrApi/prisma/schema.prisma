datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  incomes  Income[]
  expenses Expense[]
}

model Income {
  id          String   @id @default(uuid())
  amount      Float
  description String
  date        DateTime
  createdAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
}

model Expense {
  id          String   @id @default(uuid())
  amount      Float
  description String
  date        DateTime
  createdAt   DateTime @default(now())

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  expenses Expense[]
}
